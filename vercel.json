{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "production": true
    }
  },
  "buildCommand": "bash scripts/vercel-build.sh '@ifc-lite/viewer...'",
  "outputDirectory": "apps/viewer/dist",
  "installCommand": "bash scripts/vercel-install.sh",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/epsg/:path*",
      "destination": "https://epsg.io/:path*"
    },
    {
      "source": "/api/bsdd/:path*",
      "destination": "https://api.bsdd.buildingsmart.org/:path*"
    },
    {
      "source": "/api/bimcollab/:path*",
      "destination": "/api/bimcollab?path=:path*"
    },
    {
      "source": "/api/dalux/:path*",
      "destination": "/api/dalux?path=:path*"
    },
    {
      "source": "/api/buildagil/:path*",
      "destination": "/api/buildagil?path=:path*"
    },
    {
      "source": "/oauth/dropbox/callback",
      "destination": "/oauth/dropbox/callback.html"
    },
    {
      "source": "/oauth/msgraph/callback",
      "destination": "/oauth/msgraph/callback.html"
    },
    {
      "source": "/oauth/bcf/callback",
      "destination": "/oauth/bcf/callback.html"
    },
    {
      "source": "/oauth/registry/callback",
      "destination": "/oauth/registry/callback.html"
    },
    {
      "source": "/mcp",
      "destination": "/index.html"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!smlib/|retained-engine/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/(smlib|retained-engine)/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(smlib|retained-engine)/(.*)\\.(js|mjs)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(smlib|retained-engine)/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(smlib|retained-engine)/(.*)\\.(md|txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(retained-engine/LICENSES/.*|smlib/LICENSE)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
