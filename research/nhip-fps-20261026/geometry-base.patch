+        let [a,b,c]=tri.map(|i|std::array::from_fn::<_,3,_>(|axis|p[i as usize][axis]-center[axis]));
+        a[0]*(b[1]*c[2]-b[2]*c[1])+a[1]*(b[2]*c[0]-b[0]*c[2])+a[2]*(b[0]*c[1]-b[1]*c[0])
