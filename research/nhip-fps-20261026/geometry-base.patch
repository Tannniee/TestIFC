+    for feature_type in ["IFCVOIDINGFEATURE", "IFCOPENINGELEMENT", "IFCOPENINGSTANDARDCASE", "IFCEARTHWORKSCUT"] {
+        let result = process_geometry(&fixture(false, true, feature_type));
