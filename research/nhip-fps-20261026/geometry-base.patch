+/// Re-encode the same inverse-rotated points around another f64 storage
+/// origin. This changes the f32 quantization lattice, not the rigid placement.
+pub(crate) fn rebase_site_storage(mesh:&mut MeshData,positions:&[f32],origin:[f64;3],rotation:&[f64],offset:[f64;3]) {
+    mesh.positions.clear();
+    for p in positions.as_chunks::<3>().0 {
+        let mut p=p.map(f64::from);apply_inverse_rotation_point_f64(&mut p,rotation);
+        mesh.positions.extend((0..3).map(|i|(p[i]-offset[i]) as f32));
+    }
+    mesh.origin=origin;apply_inverse_rotation_point_f64(&mut mesh.origin,rotation);
+    for (p,shift) in mesh.origin.iter_mut().zip(offset){*p+=shift;}
+}
