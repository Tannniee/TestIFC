+    assert_eq!(read(&source.replace("3,0.2,$,$", "3,$,$,$")), None);
+    let mut deep = source.replace("*,*,*,*,#11", "*,*,*,*,#100");
+    for id in 100..120 {
+        deep.push_str(&format!("\n#{id}=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#{},$,.MODEL_VIEW.,$);", id + 1));
+    }
