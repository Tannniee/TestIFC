+pub(crate) fn clean_finite_buffers(mesh:&mut crate::types::mesh::MeshData,source:Option<FiniteSiteSource<'_>>) {
+    if disabled(){return;}
+    let dropped=ifc_lite_geometry::drop_collapsed_triangles(&mesh.positions,&mut mesh.indices);
+    if dropped==0{return;}
