{"code":"import assert from\"node:assert/strict\";import{describe,it}from\"node:test\";import{isEntityVisible}from\"./entity-visibility.js\";describe(\"isEntityVisible\",()=>{it(\"shows everything when neither filter is active\",()=>{assert.equal(isEntityVisible(1,null,null),true);assert.equal(isEntityVisible(1,void 0,void 0),true)});it(\"hides an id in the hidden set\",()=>{assert.equal(isEntityVisible(1,new Set([1]),null),false);assert.equal(isEntityVisible(2,new Set([1]),null),true)});it(\"treats an empty hidden set as no filter\",()=>{assert.equal(isEntityVisible(1,new Set,null),true)});it(\"shows only the isolated ids when isolation is active\",()=>{assert.equal(isEntityVisible(1,null,new Set([1])),true);assert.equal(isEntityVisible(2,null,new Set([1])),false)});it(\"treats an EMPTY isolated set as isolating nothing, not as no filter\",()=>{assert.equal(isEntityVisible(1,null,new Set),false);assert.equal(isEntityVisible(1,null,null),true)});it(\"lets hiding win over isolation\",()=>{assert.equal(isEntityVisible(1,new Set([1]),new Set([1])),false)})});\n","warnings":[],"map":{"version":3,"mappings":"AAWA,OAAO,WAAY,qBACnB,OAAS,SAAU,OAAU,YAC7B,OAAS,oBAAuB,yBAEhC,SAAS,kBAAmB,IAAM,CAChC,GAAG,iDAAkD,IAAM,CACzD,OAAO,MAAM,gBAAgB,EAAG,KAAM,IAAI,EAAG,IAAI,EACjD,OAAO,MAAM,gBAAgB,EAAG,OAAW,MAAS,EAAG,IAAI,CAC7D,CAAC,EAED,GAAG,gCAAiC,IAAM,CACxC,OAAO,MAAM,gBAAgB,EAAG,IAAI,IAAI,CAAC,CAAC,CAAC,EAAG,IAAI,EAAG,KAAK,EAC1D,OAAO,MAAM,gBAAgB,EAAG,IAAI,IAAI,CAAC,CAAC,CAAC,EAAG,IAAI,EAAG,IAAI,CAC3D,CAAC,EAED,GAAG,0CAA2C,IAAM,CAClD,OAAO,MAAM,gBAAgB,EAAG,IAAI,IAAO,IAAI,EAAG,IAAI,CACxD,CAAC,EAED,GAAG,uDAAwD,IAAM,CAC/D,OAAO,MAAM,gBAAgB,EAAG,KAAM,IAAI,IAAI,CAAC,CAAC,CAAC,CAAC,EAAG,IAAI,EACzD,OAAO,MAAM,gBAAgB,EAAG,KAAM,IAAI,IAAI,CAAC,CAAC,CAAC,CAAC,EAAG,KAAK,CAC5D,CAAC,EAED,GAAG,sEAAuE,IAAM,CAI9E,OAAO,MAAM,gBAAgB,EAAG,KAAM,IAAI,GAAK,EAAG,KAAK,EACvD,OAAO,MAAM,gBAAgB,EAAG,KAAM,IAAI,EAAG,IAAI,CACnD,CAAC,EAED,GAAG,iCAAkC,IAAM,CACzC,OAAO,MAAM,gBAAgB,EAAG,IAAI,IAAI,CAAC,CAAC,CAAC,EAAG,IAAI,IAAI,CA