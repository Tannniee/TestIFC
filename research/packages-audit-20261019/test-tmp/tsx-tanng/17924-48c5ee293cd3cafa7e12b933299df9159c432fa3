{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert/strict\";import{PERSISTENT_DEGRADATION_FRAMES,RenderDegradationMonitor}from\"./render-degradation.js\";const DETAIL=\"createBuffer failed, size (193836) is too large\";describe(\"RenderDegradationMonitor\",()=>{it(\"stays silent below the threshold\",()=>{const monitor=new RenderDegradationMonitor;for(let frames=1;frames<PERSISTENT_DEGRADATION_FRAMES;frames++){assert.equal(monitor.note(frames,DETAIL,\"frame\"),null,`frame ${frames} is still inside the transient budget`)}});it(\"reports exactly on the crossing frame, carrying count, detail and origin\",()=>{const monitor=new RenderDegradationMonitor;for(let frames=1;frames<PERSISTENT_DEGRADATION_FRAMES;frames++){monitor.note(frames,DETAIL,\"frame\")}const info=monitor.note(PERSISTENT_DEGRADATION_FRAMES,DETAIL,\"encode\");assert.notEqual(info,null,\"the crossing frame must report\");assert.equal(info.consecutiveDegradedFrames,PERSISTENT_DEGRADATION_FRAMES);assert.equal(info.detail,DETAIL);assert.equal(info.origin,\"encode\")});it(\"latches: every later frame is silent, however bad it gets\",()=>{const monitor=new RenderDegradationMonitor;let reports=0;for(let frames=1;frames<=PERSISTENT_DEGRADATION_FRAMES*10;frames++){if(monitor.note(frames,DETAIL,\"frame\"))reports++}assert.equal(reports,1)});it(\"reports on the first count that is already past the threshold\",()=>{const monitor=new RenderDegradationMonitor;const info=monitor.note(PERSISTENT_DEGRADATION_FRAMES+7,DETAIL,\"frame\");assert.notEqual(info,null,\"the comparison must be >=, not ===\");assert.equal(info.consecutiveDegradedFrames,PERSISTENT_DEGRADATION_FRAMES+7)});it(\"holds no counter of its own \\u2014 two monitors do not share state\",()=>{const a=new RenderDegradationMonitor;const b=new RenderDegradationMonitor;assert.notEqual(a.note(PERSISTENT_DEGRADATION_FRAMES,DETAIL,\"frame\"),null);assert.notEqual(b.note(PERSISTENT_DEGRADATION_FRAMES,DETAIL,\"frame\"),null);assert.equal(a.note(PERSISTENT_DEGRADATION_FRAMES+1,DETAIL,\"frame\"),null)});it(\"sets a threshold the renderer cannot reach on its own re-requests\",()=>{const MAX_SELF_DRIVEN_RUN=4;assert.ok(PERSISTENT_DEGRADATION_FRAMES>MAX_SELF_DRIVEN_RUN,\"the threshold must require externally-driven frames that also failed\")});it(\"is fed a run length, so a recovered failure never contributes\",()=>{const monitor=new RenderDegradationMonitor;let reports=0;for(let episode=0;episode<20;episode++){if(monitor.note(1,DETAIL,\"frame\"))reports++}assert.equal(reports,0,\"failures that each recovered are not a wedged viewport\")})});\n","warnings":[],"map":{"version":3,"mappings":"AAeA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,qBACnB,OACI,8BACA,6BACG,0BAEP,MAAM,OAAS,kDAEf,SAAS,2BAA4B,IAAM,CACvC,GAAG,mCAAoC,IAAM,CACzC,MAAM,QAAU,IAAI,yBACpB,QAAS,OAAS,EAAG,OAAS,8BAA+B,SAAU,CACnE,OAAO,MACH,QAAQ,KAAK,OAAQ,OAAQ,OAAO,EACpC,KACA,SAAS,MAAM,uCACnB,CACJ,CACJ,CAAC,EAED,GAAG,2EAA4E,IAAM,CACjF,MAAM,QAAU,IAAI,yBACpB,QAAS,OAAS,EAAG,OAAS,8BAA+B,SAAU,CACnE,QAAQ,KAAK,OAAQ,OAAQ,OAAO,CACxC,CACA,MAAM,KAAO,QAAQ,KAAK,8BAA+B,OAAQ,QAAQ,EACzE,OAAO,SAAS,KAAM,KAAM,gCAAgC,EAC5D,OAAO,MAAM,KAAM,0BAA2B,6BAA6B,EAC3E,OAAO,MAAM,KAAM,OAAQ,MAAM,EACjC,OAAO,MAAM,KAAM,OAAQ,QAAQ,CACvC,CAAC,EAED,GAAG,4DAA6D,IAAM,CAIlE,MAAM,QAAU,IAAI,yBACpB,IAAI,QAAU,EACd,QAAS,OAAS,EAAG,QAAU,8BAAgC,GAAI,SAAU,CACzE,GAAI,QAAQ,KAAK,OAAQ,OAAQ,OAAO,EAAG,SAC/C,CACA,OAAO,MAAM,QAAS,CAAC,CAC3B,CAAC,EAED,GAAG,gEAAiE,IAAM,CAKtE,MAAM,QAAU,IAAI,yBACpB,MAAM,KAAO,QAAQ,KAAK,8BAAgC,EAAG,OAAQ,OAAO,EAC5E,OAAO,SAAS,KAAM,KAAM,oCAAoC,EAChE,OAAO,MAAM,KAAM,0BAA2B,8BAAgC,CAAC,CACnF,CAAC,EAED,GAAG,qEAAiE,IAAM,CAItE,MAAM,EAAI,IAAI,yBACd,MAAM,EAAI,IAAI,yBACd,OAAO,SAAS,EAAE,KAAK,8BAA+B,OAAQ,OAAO,EAAG,IAAI,EAC5E,OAAO,SAAS,EAAE,KAAK,8BAA+B,OAAQ,OAAO,EAAG,IAAI,EAC5E,OAAO,MAAM,EAAE,KAAK,8BAAgC,EAAG,OAAQ,OAAO,EAAG,IAAI,CACjF,CAAC,EAED,GAAG,oEAAqE,IAAM,CAM1E,MAAM,oBAAsB,EAC5B,OAAO,GACH,8BAAgC,oBAChC,sEACJ,CACJ,CAAC,EAED,GAAG,gEAAiE,IAAM,CAKtE,MAAM,QAAU,IAAI,yBACpB,IAAI,QAAU,EAGd,QAAS,QAAU,EAAG,QAAU,GAAI