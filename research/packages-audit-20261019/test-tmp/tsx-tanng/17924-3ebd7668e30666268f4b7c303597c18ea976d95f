{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert/strict\";import{resolveShadowMapResolution}from\"./shadow-pass.js\";describe(\"resolveShadowMapResolution (#2670 review)\",()=>{it(\"Auto picks 4096 on a discrete GPU (8192+ texture limit)\",()=>{assert.equal(resolveShadowMapResolution(0,16384),4096);assert.equal(resolveShadowMapResolution(void 0,8192),4096)});it(\"Auto picks 2048 on a 4096-capped iGPU\",()=>{assert.equal(resolveShadowMapResolution(0,4096),2048)});it(\"Auto falls back to 1024 when the device limit is small or unknown\",()=>{assert.equal(resolveShadowMapResolution(0,2048),1024);assert.equal(resolveShadowMapResolution(0,Number.NaN),1024);assert.equal(resolveShadowMapResolution(0,0),1024)});it(\"honours a manual value that fits the device\",()=>{assert.equal(resolveShadowMapResolution(2048,8192),2048);assert.equal(resolveShadowMapResolution(4096,8192),4096);assert.equal(resolveShadowMapResolution(1024,8192),1024)});it(\"clamps a manual value that exceeds the device limit (createTexture would fail)\",()=>{assert.equal(resolveShadowMapResolution(4096,2048),2048)});it(\"floors and clamps a fractional or sub-256 manual value to match allocation (#3053)\",()=>{assert.equal(resolveShadowMapResolution(1,8192),256);assert.equal(resolveShadowMapResolution(100,8192),256);assert.equal(resolveShadowMapResolution(2048.9,8192),2048)})});\n","warnings":[],"map":{"version":3,"mappings":"AAWA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,qBAEnB,OAAS,+BAAkC,mBAE3C,SAAS,4CAA6C,IAAM,CAC1D,GAAG,0DAA2D,IAAM,CAClE,OAAO,MAAM,2BAA2B,EAAG,KAAK,EAAG,IAAI,EACvD,OAAO,MAAM,2BAA2B,OAAW,IAAI,EAAG,IAAI,CAChE,CAAC,EAED,GAAG,wCAAyC,IAAM,CAChD,OAAO,MAAM,2BAA2B,EAAG,IAAI,EAAG,IAAI,CACxD,CAAC,EAED,GAAG,oEAAqE,IAAM,CAC5E,OAAO,MAAM,2BAA2B,EAAG,IAAI,EAAG,IAAI,EACtD,OAAO,MAAM,2BAA2B,EAAG,OAAO,GAAG,EAAG,IAAI,EAC5D,OAAO,MAAM,2BAA2B,EAAG,CAAC,EAAG,IAAI,CACrD,CAAC,EAED,GAAG,8CAA+C,IAAM,CACtD,OAAO,MAAM,2BAA2B,KAAM,IAAI,EAAG,IAAI,EACzD,OAAO,MAAM,2BAA2B,KAAM,IAAI,EAAG,IAAI,EACzD,OAAO,MAAM