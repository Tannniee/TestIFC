{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{test}from\"node:test\";import assert from\"node:assert/strict\";import{Camera}from\"./camera.js\";import{TestIfcCameraTransition}from\"./camera-testifc-transition.js\";function camera(height=800){const c=new Camera;c.configureNavigation(\"testifc\",height);c.setAspect(1);c.setProjectionMode(\"orthographic\");c.setOrthoSize(10);c.setPosition(0,0,20);c.setTarget(0,0,0);return c}__name(camera,\"camera\");function settle(c,step=16){for(let elapsed=0;elapsed<2400;elapsed+=step)c.update(step)}__name(settle,\"settle\");function close(a,b){assert.ok(Math.abs(a-b)<1e-5,`${a} != ${b}`)}__name(close,\"close\");test(\"TestIFC wheel keeps cursor point fixed, preserves distance and reverses exactly\",()=>{const c=camera(),point={x:4,y:2,z:0};const pixel=c.projectToScreen(point,800,800);const before={position:c.getPosition(),target:c.getTarget(),size:c.getOrthoSize()};c.zoom(-100,false,pixel.x,pixel.y,800,800);close(c.getDistance(),20);close(c.getOrthoSize(),9.5);const after=c.projectToScreen(point,800,800);close(after.x,pixel.x);close(after.y,pixel.y);c.zoom(100,false,pixel.x,pixel.y,800,800);close(c.getOrthoSize(),before.size);for(const axis of[\"x\",\"y\",\"z\"]){close(c.getPosition()[axis],before.position[axis]);close(c.getTarget()[axis],before.target[axis])}});test(\"TestIFC rotation follows viewport size and has the same endpoint at different refresh rates\",()=>{const a=camera(800),b=camera(1600),fast=camera(800);a.orbitSmoothed(100,0);b.orbitSmoothed(200,0);fast.orbitSmoothed(100,0);settle(a);settle(b);settle(fast,5);close(Math.atan2(a.getPosition().x,a.getPosition().z),-Math.PI/4);for(const axis of[\"x\",\"y\",\"z\"]){close(a.getPosition()[axis],b.getPosition()[axis]);close(a.getPosition()[axis],fast.getPosition()[axis])}assert.deepEqual(a.getTarget(),{x:0,y:0,z:0})});test(\"TestIFC pan tracks screen pixels at different zoom levels and explic