{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert\";import{createCpuFrameTicker}from\"./frame-timing-cpu.js\";import{computeDurationStats}from\"./frame-timing-stats.js\";describe(\"createCpuFrameTicker\",()=>{it(\"records no deltas after a single tick (needs a boundary on both sides)\",()=>{const ticker=createCpuFrameTicker();ticker.tick(1e3);assert.deepStrictEqual(ticker.deltasMs(),[])});it(\"computes exact, non-round, asymmetric inter-frame deltas from synthetic timestamps\",()=>{const ticker=createCpuFrameTicker();ticker.tick(1000.25);ticker.tick(1008.375);ticker.tick(1013.125);ticker.tick(1054.375);assert.deepStrictEqual(ticker.deltasMs(),[8.125,4.75,41.25])});it(\"feeds straight into the shared stats primitive (same DurationStats shape as GPU-queries mode)\",()=>{const ticker=createCpuFrameTicker();for(const t of[0,8.125,12.875,54.125])ticker.tick(t);const stats=computeDurationStats(ticker.deltasMs());assert.strictEqual(stats.count,3);assert.strictEqual(stats.max,41.25)});it(\"deltasMs() returns a snapshot \\u2014 mutating the returned array does not affect the ticker\",()=>{const ticker=createCpuFrameTicker();ticker.tick(0);ticker.tick(5);const snapshot=ticker.deltasMs();snapshot.push(999);assert.deepStrictEqual(ticker.deltasMs(),[5])})});\n","warnings":[],"map":{"version":3,"mappings":"AAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cAEnB,OAAS,yBAA4B,wBACrC,OAAS,yBAA4B,0BAErC,SAAS,uBAAwB,IAAM,CACrC,GAAG,yEAA0E,IAAM,CACjF,MAAM,OAAS,qBAAqB,EACpC,OAAO,KAAK,GAAI,EAChB,OAAO,gBAAgB,OAAO,SAAS,EAAG,CAAC,CAAC,CAC9C,CAAC,EAED,GAAG,qFAAsF,IAAM,CAI7F,MAAM,OAAS,qBAAqB,EACpC,OAAO,KAAK,OAAO,EACnB,OAAO,KAAK,QAAQ,EACpB,OAAO,KAAK,QAAQ,EACpB,OAAO,KAAK,QAAQ,EACpB,OAAO,gBAAgB,OAAO,SAAS,EAAG,CAAC,MAAO,KAAM,KAAK,CAAC,CAChE,CAAC,EAED,GAAG,gGAAiG,IAAM,CACxG,MAAM,OAAS,qBAAqB,EAGpC,UAAW,IAAK,CAAC,EAAG,MAAO,OAAQ,MAAM,EAAG,OAAO,KAAK,CAAC,EACzD,MAAM,MAAQ,qBAAqB,OAAO,SAAS,CAAC,EACpD,OAAO,YAAY,MAAM,MAAO,CAAC,EACjC,OAAO,YAAY,MAAM,IAAK,KAAK,CACrC,CAAC,EAED,GAAG,8FAA0F,IAAM,CAC