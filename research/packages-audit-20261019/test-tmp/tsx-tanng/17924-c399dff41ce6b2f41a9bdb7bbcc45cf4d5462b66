{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{describe,it}from\"node:test\";import assert from\"node:assert\";import{pickFitPolicy}from\"./camera-fit-policy.js\";const FOV_45=45*Math.PI/180;function bounds(minX,minY,minZ,maxX,maxY,maxZ){return{min:{x:minX,y:minY,z:minZ},max:{x:maxX,y:maxY,z:maxZ}}}__name(bounds,\"bounds\");function assertCloseTo(actual,expected,digits,message){const tolerance=.5*10**-digits;assert.ok(Math.abs(actual-expected)<tolerance,message??`expected ${actual} to be within ${tolerance} of ${expected}`)}__name(assertCloseTo,\"assertCloseTo\");describe(\"pickFitPolicy\",()=>{describe(\"compact branch\",()=>{it(\"reproduces the legacy SE isometric pose for a unit-aspect bbox\",()=>{const policy=pickFitPolicy(bounds(0,0,0,10,10,10),{fovY:FOV_45});assert.strictEqual(policy.kind,\"compact\");assert.strictEqual(policy.aspect,1);assertCloseTo(policy.distance,20,5);assertCloseTo(policy.position.x,5+20*.6,5);assertCloseTo(policy.position.y,5+20*.5,5);assertCloseTo(policy.position.z,5+20*.6,5);assert.deepStrictEqual(policy.target,{x:5,y:5,z:5});assert.deepStrictEqual(policy.up,{x:0,y:1,z:0})});it(\"treats a moderately tall building (50x100x30) as compact\",()=>{const policy=pickFitPolicy(bounds(0,0,0,50,100,30),{fovY:FOV_45});assert.strictEqual(policy.kind,\"compact\");assert.strictEqual(policy.distance,200)});it(\"still picks compact for a flat slab (50x50x5) \\u2014 aspect 10:1\",()=>{const policy=pickFitPolicy(bounds(0,0,0,50,5,50),{fovY:FOV_45});assert.strictEqual(policy.kind,\"compact\");assert.strictEqual(policy.aspect,10)});it(\"keeps a small high-aspect element compact (single rebar, issue #1350)\",()=>{const policy=pickFitPolicy(bounds(2005.06,5961.1,25.5,2005.097,5961.184,30.36),{fovY:FOV_45});assert.strictEqual(policy.kind,\"compact\");assert.ok(policy.aspect>100,`aspect ${policy.aspect} should exceed 100`);assert.ok(policy.distance>9&&policy.distance<11,`distance ${policy.distance} should be ~2x the 4.86 m length`)});it(\"honours the linearMinLongest floor override\",()=>{const b=bounds(0,0,0,80,1,1);assert.strictEqual(pickFitPolicy(b,{fovY:FOV_45}).kind,\"compact\");assert.strictEqual(pickFitPolicy(b,{fovY:FOV_45,linearMinLongest:50}).kind,\"linear\")})});describe(\"linear branch\",()=>{it(\"switches to linear for the railway-fixture aspect (932:0.75)\",()=>{const policy=pickFitPolicy(bounds(-.25,0,-428,932.59,.75,.25),{fovY:FOV_45,viewportShortPx:664});assert.strictEqual(policy.kind,\"linear\");assert.ok(policy.aspect>1e3,`aspect ${policy.aspect} should exceed 1000`);assert.ok(policy.distance<932.84*.31,`distance ${policy.distance} should stay under 30% of longest`);assert.ok(policy.distance>50,`distance ${policy.distance} should exceed 50`)});it(\"targets the bbox centre (so user can pan along the alignment)\",()=>{const b=bounds(-.25,0,-428,932.59,.75,.25);const policy=pickFitPolicy(b,{fovY:FOV_45});assertCloseTo(policy.target.x,466.17,1);assertCloseTo(policy.target.y,.375,2);assertCloseTo(policy.target.z,-213.875,1)});it(\"looks down-and-along the longest axis\",()=>{const policy=pickFitPolicy(bounds(0,0,0,1e3,1,50),{fovY:FOV_45});const dir={x:policy.target.x-policy.position.x,y:policy.target.y-policy.position.y,z:policy.target.z-policy.position.z};const len=Math.sqrt(dir.x*dir.x+dir.y*dir.y+dir.z*dir.z);const dx=dir.x/len;const dy=dir.y/len;assertCloseTo(dx,Math.cos(20*Math.PI/180),3);assertCloseTo(dy,-Math.sin(20*Math.PI/180),3)});it(\"respects whichever axis is longest (Z-major)\",()=>{const policy=pickFitPolicy(bounds(0,0,0,50,1,1e3),{fovY:FOV_45});const dir={x:policy.target.x-policy.position.x,z:policy.target.z-policy.position.z};const len=Math.sqrt(dir.x*dir.x+dir.z*dir.z);assert.ok(Math.abs(dir.x/len)<.01,\"X component should be negligible\");assert.ok(dir.z>0,\"should be looking +Z\")});it(\"actually tilts a Y-dominant model (issue #2441)\",()=>{const policy=pickFitPolicy(bounds(0,0,0,5,300,5),{fovY:FOV_45});assert.strictEqual(policy.kind,\"linear\");assert.deepStrictEqual(policy.up,{x:0,y:1,z:0});const dir={x:policy.target.x-policy.position.x,y:policy.target.y-policy.position.y,z:policy.target.z-policy.position.z};const len=Math.sqrt(dir.x*dir.x+dir.y*dir.y+dir.z*dir.z);assert.ok(len>0,\"position and target must differ\");const forward={x:dir.x/len,y:dir.y/len,z:dir.z/len};assertCloseTo(forward.x,0,6);assertCloseTo(forward.y,Math.cos(20*Math.PI/180),6);assertCloseTo(forward.z,-Math.sin(20*Math.PI/180),6);const cross={x:forward.y*policy.up.z-forward.z*policy.up.y,y:forward.z*policy.up.x-forward.x*policy.up.z,z:forward.x*policy.up.y-forward.y*policy.up.x};const crossLen=Math.sqrt(cross.x*cross.x+cross.y*cross.y+cross.z*cross.z);assertCloseTo(crossLen,Math.sin(20*Math.PI/180),6)});it(\"floors the feature size against pathological zero-thin bboxes\",()=>{const policy=pickFitPolicy(bounds(0,0,0,1e3,1e-4,1),{fovY:FOV_45});assert.strictEqual(policy.kind,\"linear\");assert.ok(policy.distance>1,`distance ${policy.distance} should exceed 1`);assert.ok(policy.distance<1e3*.31,`distance ${policy.distance} should stay under 310`)});it(\"solves the feature-pixel equation when neither clamp binds\",()=>{const policy=pickFitPolicy(bounds(0,0,0,1e3,1e-4,1),{fovY:FOV_45,viewportShortPx:200});assert.strictEqual(policy.kind,\"linear\");const expected=10*200/(2*16*Math.tan(FOV_45/2));assertCloseTo(policy.distance,expected,6);assertCloseTo(policy.distance,150.8879,3);const minDistance=1e3*.05/Math.max(Math.tan(FOV_45/2),.05);assert.ok(policy.distance>minDistance,`expected > minDistance ${minDistance}`);assert.ok(policy.distance<1e3*.3,\"expected below maxDistance 300\");const tallerViewport=pickFitPolicy(bounds(0,0,0,1e3,1e-4,1),{fovY:FOV_45,viewportShortPx:300});assertCloseTo(tallerViewport.distance,expected*1.5,6);const wideFov=pickFitPolicy(bounds(0,0,0,1e3,1e-4,1),{fovY:90*Math.PI/180,viewportShortPx:200});assertCloseTo(wideFov.distance,10*200/(2*16*Math.tan(Math.PI/4)),6);assert.ok(wideFov.distance<policy.distance,\"a wider FOV must need less distance\")});it(\"caps the linear distance at 30% of the longest axis\",()=>{const policy=pickFitPolicy(bounds(0,0,0,1e4,100,100),{fovY:FOV_45});assert.strictEqual(policy.kind,\"linear\");assert.ok(policy.distance<=1e4*.3,`distance ${policy.distance} should be capped at 3000`)})});it(\"honours an override threshold (so tests can pin the boundary)\",()=>{const b=bounds(0,0,0,100,20,20);assert.strictEqual(pickFitPolicy(b,{fovY:FOV_45}).kind,\"compact\");assert.strictEqual(pickFitPolicy(b,{fovY:FOV_45,linearAspectThreshold:4}).kind,\"linear\")})});\n","warnings":[],"map":{"version":3,"mappings":"kHAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cACnB,OAAS,kBAAmC,yBAE5C,MAAM,OAAU,GAAK,KAAK,GAAM,IAEhC,SAAS,OAAO,KAAc,KAAc,KAAc,KAAc,KAAc,KAAuB,CAC3G,MAAO,CAAE,IAAK,CAAE,EAAG,KAAM,EAAG,KAAM,EAAG,IAAK,EAAG,IAAK,CAAE,EAAG,KAAM,EAAG,KAAM,EAAG,IAAK,CAAE,CAClF,CAFS,wBAIT,SAAS,cAAc,OAAgB,SAAkB,OAAgB,QAAwB,CAC/F,MAAM,UAAY,GAAM,IAAM,CAAC,OAC/B,OAAO,GACL,KAAK,IAAI,OAAS,QAAQ,EAAI,UAC9B,SAAW,YAAY,MAAM,iBAAiB,SAAS,OAAO,QAAQ,EACxE,CACF,CANS,sCAQT,SAAS,gBAAiB,IAAM,CAC9B,SAAS,iBAAkB,IAAM,CAC/B,GAAG,iEAAkE,IAAM,CAIzE,MAAM,OAAS,cAAc,OAAO,EAAG,EAAG,EAAG,GAAI,GAAI,EAAE,EAAG,CAAE,KAAM,MAAO,CAAC,EAC1E,OAAO,YAAY,OAAO,KAAM,SAAS,EACzC,OAAO,YAAY,OAAO,OAAQ,CAAC,EAEnC,cAAc,OAAO,SAAU,GAAI,CAAC,EAEpC,cAAc,OAAO,SAAS,EAAG,EAAI,GAAK,GAAK,CAAC,EAChD,cAAc,OAAO,SAAS,EAAG,EAAI,GAAK,GAAK,CAAC,EAChD,cAAc,OAAO,SAAS,EAAG,EAAI,GAAK,GAAK,CAAC,EAEhD,OAAO,gBAAgB,OAAO,OAAQ,CAAE,EAAG,EAAG,EAAG,EAAG,EAAG,CAAE,CAAC,EAC1D,OAAO,gBAAgB,OAAO,GAAI,CAAE,EAAG,EAAG,EAAG,EAAG,EAAG,CAAE,CAAC,CACxD,CAAC,EAED,GAAG,2DAA4D,IAAM,CAInE,MAAM,OAAS,cAAc,OAAO,EAAG,EAAG,EAAG,GAAI,IAAK,EAAE,EAAG,CAAE,KAAM,MAAO,CAAC,EAC3E,OAAO,YAAY,OAAO,KAAM,SAAS,EACzC,OAAO,YAAY,OAAO,SAAU,GAAG,CACzC,CAAC,EAED,GAAG,mEAA+D,IAAM,CAGtE,MAAM,OAAS,cAAc,OAAO,EAAG,EAAG,EAAG,GAAI,EAAG,EAAE,EAAG,CAAE,KAAM,MAAO,CAAC,EACzE,OAAO,YAAY,OAAO,KAAM,SAAS,EACzC,OAAO,YAAY,OAAO,OAAQ,EAAE,CACtC,CAAC,EAED,GAAG,wEAAyE,IAAM,CAMhF,MAAM,OAAS