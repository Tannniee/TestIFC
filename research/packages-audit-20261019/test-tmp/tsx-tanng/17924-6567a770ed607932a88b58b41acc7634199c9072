{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert\";import{aabbEdgeLineList,anchoredAabbEdgeLineList}from\"./aabb-edges.js\";describe(\"aabbEdgeLineList (#1277 clash overlap box)\",()=>{it(\"emits 12 edges (24 vertices, 72 floats)\",()=>{const v=aabbEdgeLineList([0,0,0],[1,2,3]);assert.equal(v.length,72)});it(\"every coordinate is a corner of the AABB\",()=>{const v=aabbEdgeLineList([0,0,0],[1,2,3]);for(let i=0;i<v.length;i+=3){assert.ok(v[i]===0||v[i]===1,`x ${v[i]} is a box corner`);assert.ok(v[i+1]===0||v[i+1]===2,`y ${v[i+1]} is a box corner`);assert.ok(v[i+2]===0||v[i+2]===3,`z ${v[i+2]} is a box corner`)}});it(\"each emitted edge has unit-length axis alignment (differs in exactly one axis)\",()=>{const v=aabbEdgeLineList([0,0,0],[4,5,6]);for(let e=0;e<v.length;e+=6){const dx=v[e]!==v[e+3]?1:0;const dy=v[e+1]!==v[e+4]?1:0;const dz=v[e+2]!==v[e+5]?1:0;assert.equal(dx+dy+dz,1,\"a box edge changes exactly one axis\")}});it(\"keeps a centimetre clash box local at a 5,000-km origin (#5049)\",()=>{const edges=anchoredAabbEdgeLineList([5000000015625e-6,20,-4],[5000000025625e-6,20.02,-3.99]);assert.deepEqual(edges.origin,[5000000015625e-6,20,-4]);assert.equal(edges.localVertices.length,72);assert.ok(Math.abs(edges.localVertices[3]-.01)<1e-8,`local 1-cm extent became ${edges.localVertices[3]}`)})});\n","warnings":[],"map":{"version":3,"mappings":"AAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cAEnB,OAAS,iBAAkB,6BAAgC,kBAE3D,SAAS,6CAA8C,IAAM,CAC3D,GAAG,0CAA2C,IAAM,CAClD,MAAM,EAAI,iBAAiB,CAAC,EAAG,EAAG,CAAC,EAAG,CAAC,EAAG,EAAG,CAAC,CAAC,EAC/C,OAAO,MAAM,EAAE,OAAQ,EAAE,CAC3B,CAAC,EAED,GAAG,2CAA4C,IAAM,CACnD,MAAM,EAAI,iBAAiB,CAAC,EAAG,EAAG,CAAC,EAAG,CAAC,EAAG,EAAG,CAAC,CAAC,EAC/C,QAAS,EAAI,EAAG,EAAI,EAAE,OAAQ,GAAK,EAAG,CACpC,OAAO,GAAG,EAAE,CAAC,IAAM,GAAK,EAAE,CAAC,IAAM,EAAG,KAAK,EAAE,CAAC,CAAC,kBAAkB,EAC/D,OAAO,GAAG,EAAE,EAAI,CAAC,IAAM,GAAK,EAAE,EAAI,CAAC,IAAM,EAAG,KAAK,EAAE,EAAI,CAAC,CAAC,kBAAkB,EAC3E,OAAO,GAAG,EAAE,EAAI,CAAC,IAAM,GAAK,EAAE,EAAI,CAAC,IAAM,E