ectsGovernor;const{results}=burst(gov,0,24,33);assert.equal(results[results.length-1],false,\"33ms cadence registers misses\")});test(\"app-throttled cadence is not treated as missed frames\",()=>{const gov=new InteractionEffectsGovernor;const{results}=burst(gov,0,60,33,false,33);assert.ok(results.every(Boolean),\"throttled cadence stays clean\");const r2=burst(gov,60*33+33,24,70,false,33);assert.equal(r2.results[r2.results.length-1],false,\"70ms vs 33ms target degrades\")});test(\"refresh estimate re-calibrates per window across display changes\",()=>{const gov=new InteractionEffectsGovernor;burst(gov,0,60,8.3);gov.frame(false,2e3);const{results}=burst(gov,3e3,80,16.7);assert.ok(results.every(Boolean),\"60Hz cadence is clean after 120Hz history\")});test(\"burst gap is not counted as a missed frame\",()=>{const gov=new InteractionEffectsGovernor;let t=0;for(let i=0;i<10;i++){const{last}=burst(gov,t,10,16.7);t=last+2e3;gov.frame(false,t-1e3)}const{results}=burst(gov,t,20,16.7);assert.ok(results.every(Boolean),\"gaps between gestures never degrade\")});\n","warnings":[],"map":{"version":3,"mappings":"kHAIA,OAAS,SAAY,YACrB,OAAO,WAAY,qBACnB,OAAS,+BAAkC,oCAG3C,SAAS,MACL,IACA,MACA,EACA,MACA,SAAW,MACX,mBAAqB,EACe,CACpC,MAAM,QAAqB,CAAC,EAC5B,IAAI,EAAI,MACR,QAAS,EAAI,EAAG,EAAI,EAAG,IAAK,CACxB,QAAQ,KAAK,IAAI,MAAM,KAAM,EAAG,SAAU,kBAAkB,CAAC,EAC7D,GAAK,KACT,CACA,MAAO,CAAE,KAAM,EAAI,MAAO,OAAQ,CACtC,CAfS,sBAiBT,KAAK,mCAAoC,IAAM,CAC3C,MAAM,IAAM,IAAI,2BAChB,OAAO,MAAM,IAAI,MAAM,MAAO,CAAC,EAAG,IAAI,EACtC,OAAO,MAAM,IAAI,MAAM,MAAO,GAAI,EAAG,IAAI,CAC7C,CAAC,EAED,KAAK,4CAA6C,IAAM,CACpD,MAAM,IAAM,IAAI,2BAChB,KAAM,CAAE,OAAQ,EAAI,MAAM,IAAK,EAAG,IAAK,IAAI,EAC3C,OAAO,GAAG,QAAQ,MAAM,OAAO,EAAG,2CAA2C,CACjF,CAAC,EAED,KAAK,6CAA8C,IAAM,CACrD,MAAM,IAAM,IAAI,2BAChB,KAAM,CAAE,OAAQ,EAAI,MAAM,IAAK,EAAG,IAAK,GAAG,EAC1C,OAAO,GAAG,QAAQ,MAAM,OAAO,CAAC,CACpC,CAAC,EAED,KAAK,oDAAqD,IAAM,CAC5D,MAAM,IAAM,IAAI,2BAEhB,KAAM,CAAE,IAAK,EAAI,MAAM,IAAK,EAAG,GAAI,IAAI,EACvC,KAAM,CAAE,OAAQ,EAAI,MAAM,IAAK,KAAO,GAAI,GAAI