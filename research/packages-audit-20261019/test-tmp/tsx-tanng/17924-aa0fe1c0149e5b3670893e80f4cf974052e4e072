{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert\";import{shouldRouteMeshTransparent,shouldRouteBatchTransparent,splitVisibleIdsByPromotion}from\"./overlay-routing.js\";describe(\"shouldRouteMeshTransparent\",()=>{it(\"routes opaque meshes to the opaque pipeline\",()=>{assert.strictEqual(shouldRouteMeshTransparent(1,0,42,null),false);assert.strictEqual(shouldRouteMeshTransparent(.995,0,42,null),false)});it(\"routes low-alpha meshes to the transparent pipeline by default\",()=>{assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,null),true);assert.strictEqual(shouldRouteMeshTransparent(.5,0,42,null),true)});it(\"routes PBR-transparent meshes to the transparent pipeline\",()=>{assert.strictEqual(shouldRouteMeshTransparent(1,.5,42,null),true)});it(\"promotes a lens-overridden IfcSpace-like mesh to opaque (issue #677)\",()=>{const overrides=new Map([[42,[1,0,0,1]]]);assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,overrides),false)});it(\"does not promote unrelated meshes when overrides target other ids\",()=>{const overrides=new Map([[7,[1,0,0,1]]]);assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,overrides),true)});it(\"treats an empty override map as no overrides\",()=>{const overrides=new Map;assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,overrides),true)});it(\"leaves ghost-tier overrides (alpha < 0.2) in the transparent path\",()=>{const overrides=new Map([[42,[.6,.6,.6,.15]]]);assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,overrides),true)});it('promotes \"transparent\" lens action (alpha 0.3) overrides',()=>{const overrides=new Map([[42,[1,0,0,.3]]]);assert.strictEqual(shouldRouteMeshTransparent(.3,0,42,overrides),false)})});describe(\"shouldRouteBatchTransparent\",()=>{it(\"routes opaque batches to opaque\",()=>{assert.strictEqual(shouldRouteBatchTransparent(1,[1,2,3],null),false)});it(\"routes transparent batches with no overrides to transparent\",()=>{assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],null),true)});it(\"promotes a homogeneous overridden batch to opaque (post-split)\",()=>{const overrides=new Map([[1,[1,0,0,1]],[2,[0,1,0,1]],[3,[0,0,1,1]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),false)});it(\"keeps mixed batches transparent (must be split upstream)\",()=>{const overrides=new Map([[2,[0,1,0,1]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),true)});it(\"keeps the batch transparent when no id is overridden\",()=>{const overrides=new Map([[99,[0,1,0,1]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),true)});it(\"treats an empty override map as no overrides\",()=>{const overrides=new Map;assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),true)});it(\"handles empty batches safely\",()=>{assert.strictEqual(shouldRouteBatchTransparent(.3,[],null),true);const overrides=new Map([[1,[0,1,0,1]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[],overrides),true)});it(\"does not promote a batch whose only overridden id is ghost-tier\",()=>{const overrides=new Map([[2,[.6,.6,.6,.15]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),true)});it(\"does not promote when an id has only a ghost-tier override (mixed batch)\",()=>{const overrides=new Map([[1,[.6,.6,.6,.15]],[2,[1,0,0,1]]]);assert.strictEqual(shouldRouteBatchTransparent(.3,[1,2,3],overrides),true)})});describe(\"splitVisibleIdsByPromotion\",()=>{it(\"returns null when there are no overrides\",()=>{assert.strictEqual(splitVisibleIdsByPromotion([1,2,3],null),null);assert.strictEqual(splitVisibleIdsByPromotion([1,2,3],new Map),null)});it(\"returns null when no input id is overridden\",()=>{const overrides=new Map([[99,[1,0,0,1]]]);assert.strictEqual(splitVisibleIdsByPromotion([1,2,3],overrides),null)});it(\"splits ids into promoted (deliberate) and remaining\",()=>{const overrides=new Map([[1,[1,0,0,1]],[3,[0,1,0,.5]]]);const split=splitVisibleIdsByPromotion([1,2,3,4],overrides);assert.ok(split!=null);assert.deepStrictEqual([...split.promoted].sort(),[1,3]);assert.deepStrictEqual([...split.remaining].sort(),[2,4])});it(\"keeps ghost-tier overrides in remaining\",()=>{const overrides=new Map([[1,[1,0,0,1]],[2,[.6,.6,.6,.15]]]);const split=splitVisibleIdsByPromotion([1,2,3],overrides);assert.ok(split!=null);assert.deepStrictEqual([...split.promoted],[1]);assert.deepStrictEqual([...split.remaining].sort(),[2,3])});it(\"returns empty remaining when every id is deliberately overridden\",()=>{const overrides=new Map([[1,[1,0,0,1]],[2,[0,1,0,1]]]);const split=splitVisibleIdsByPromotion([1,2],overrides);assert.ok(split!=null);assert.deepStrictEqual([...split.promoted].sort(),[1,2]);assert.strictEqual(split.remaining.size,0)})});\n","warnings":[],"map":{"version":3,"mappings":"AAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cAEnB,OACE,2BACA,4BACA,+BACK,uBAIP,SAAS,6BAA8B,IAAM,CAC3C,GAAG,8CAA+C,IAAM,CACtD,OAAO,YAAY,2BAA2B,EAAK,EAAK,GAAI,IAAI,EAAG,KAAK,EACxE,OAAO,YAAY,2BAA2B,KAAO,EAAK,GAAI,IAAI,EAAG,KAAK,CAC5E,CAAC,EAED,GAAG,iEAAkE,IAAM,CACzE,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,IAAI,EAAG,IAAI,EACvE,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,IAAI,EAAG,IAAI,CACzE,CAAC,EAED,GAAG,4DAA6D,IAAM,CAEpE,OAAO,YAAY,2BAA2B,EAAK,GAAK,GAAI,IAAI,EAAG,IAAI,CACzE,CAAC,EAED,GAAG,uEAAwE,IAAM,CAI/E,MAAM,UAAuB,IAAI,IAAI,CAAC,CAAC,GAAI,CAAC,EAAG,EAAG,EAAG,CAAC,CAAC,CAAC,CAAC,EACzD,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,SAAS,EAAG,KAAK,CAC/E,CAAC,EAED,GAAG,oEAAqE,IAAM,CAC5E,MAAM,UAAuB,IAAI,IAAI,CAAC,CAAC,EAAG,CAAC,EAAG,EAAG,EAAG,CAAC,CAAC,CAAC,CAAC,EACxD,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,SAAS,EAAG,IAAI,CAC9E,CAAC,EAED,GAAG,+CAAgD,IAAM,CACvD,MAAM,UAAuB,IAAI,IACjC,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,SAAS,EAAG,IAAI,CAC9E,CAAC,EAED,GAAG,oEAAqE,IAAM,CAG5E,MAAM,UAAuB,IAAI,IAAI,CAAC,CAAC,GAAI,CAAC,GAAK,GAAK,GAAK,GAAI,CAAC,CAAC,CAAC,EAClE,OAAO,YAAY,2BAA2B,GAAK,EAAK,GAAI,SAAS,EAAG,IAAI,CAC9E,CAAC,EAED,GAAG,2DAA4D,IAAM,CAEnE,MAAM,UAAuB,IAAI,IAAI,CAAC,CAAC,GAAI,CAAC,EAAG,EAAG,EAAG,EAAG,CAAC,CAAC,CAAC,EAC3D,OAAO,YAAY,2BAA2B,GAAK,E