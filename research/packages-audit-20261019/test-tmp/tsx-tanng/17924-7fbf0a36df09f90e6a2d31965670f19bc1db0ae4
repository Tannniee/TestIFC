{"code":"var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,\"name\",{value,configurable:true});import{describe,it}from\"node:test\";import assert from\"node:assert\";import{resolveEnvironment,packEnvironmentUniforms,deriveSkyGradient,ENVIRONMENT_UNIFORM_SIZE}from\"./environment.js\";function assertClose(actual,expected,eps=1e-6,msg){assert.ok(Math.abs(actual-expected)<eps,msg??`${actual} !\\u2248 ${expected}`)}__name(assertClose,\"assertClose\");describe(\"resolveEnvironment\",()=>{it(\"defaults are the one-sided rig (#5382)\",()=>{const env=resolveEnvironment();const len=Math.hypot(-.45,1,.6);assertClose(env.sunDirection[0],-.45/len);assertClose(env.sunDirection[1],1/len);assertClose(env.sunDirection[2],.6/len);assert.strictEqual(env.sunIntensity,.4);assert.deepStrictEqual(env.sunColor,[1,1,1]);assert.deepStrictEqual(env.skyColor,[.34,.35,.36]);assert.deepStrictEqual(env.groundColor,[.24,.2,.17]);assert.strictEqual(env.ambientIntensity,.775);assert.strictEqual(env.fillIntensity,.1);assert.strictEqual(env.rimIntensity,.05);assert.strictEqual(env.sunSoftness,.3);assert.strictEqual(env.exposure,.85);assert.strictEqual(env.skyEnabled,false)});it(\"normalizes a non-unit sun direction\",()=>{const env=resolveEnvironment({sunDirection:[0,2,0]});assert.deepStrictEqual(env.sunDirection,[0,1,0])});it(\"falls back to the default sun for a degenerate direction\",()=>{const env=resolveEnvironment({sunDirection:[0,0,0]});assert.ok(env.sunDirection[1]>.5);assertClose(Math.hypot(...env.sunDirection),1)});it(\"honours explicit sky overrides and derives the rest\",()=>{const env=resolveEnvironment({sunDirection:[0,1,0],sky:{zenith:[0,0,1]}});assert.deepStrictEqual(env.sky.zenith,[0,0,1]);assert.ok(env.sky.horizon[0]>.3)})});describe(\"a non-finite sun direction never reaches the lighting uniform (#2489)\",()=>{const DEFAULT=resolveEnvironment().sunDirection;it(\"falls back for an Infinity component\",()=>{const env=resolveEnvironment({sunDirection:[Infinity,1,.3]});assert.deepStrictEqual(env.sunDirection,DEFAULT)});it(\"falls back for a -Infinity component\",()=>{const env=resolveEnvironment({sunDirection:[.5,-Infinity,.3]});assert.deepStrictEqual(env.sunDirection,DEFAULT)});it(\"falls back for a NaN component\",()=>{const env=resolveEnvironment({sunDirection:[.5,1,NaN]});assert.deepStrictEqual(env.sunDirection,DEFAULT)});it(\"falls back when a finite direction overflows to an infinite length\",()=>{const env=resolveEnvironment({sunDirection:[17e307,17e307,0]});assert.deepStrictEqual(env.sunDirection,DEFAULT)});it(\"writes only finite floats into the packed uniform\",()=>{const buf=packEnvironmentUniforms(resolveEnvironment({sunDirection:[Infinity,1,.3]}));for(let i=0;i<buf.length;i++){assert.ok(Number.isFinite(buf[i]),`uniform float ${i} is ${buf[i]}`)}});it(\"still normalizes a short but perfectly valid direction\",()=>{const env=resolveEnvironment({sunDirection:[3e-6,4e-6,0]});assertClose(env.sunDirection[0],.6);assertClose(env.sunDirection[1],.8);assert.strictEqual(env.sunDirection[2],0)});it(\"still normalizes a very large but representable direction\",()=>{const env=resolveEnvironment({sunDirection:[1e300,0,0]});assert.deepStrictEqual(env.sunDirection,[1,0,0])})});describe(\"packEnvironmentUniforms\",()=>{it(\"packs the WGSL struct layout exactly\",()=>{const env=resolveEnvironment({sunDirection:[1,0,0],sunColor:[.9,.8,.7],sunIntensity:.6,skyColor:[.1,.2,.3],groundColor:[.4,.5,.6],ambientIntensity:.3,fillIntensity:.11,rimIntensity:.12,sunSoftness:.42,exposure:1});const buf=packEnvironmentUniforms(env);assert.strictEqual(buf.byteLength,ENVIRONMENT_UNIFORM_SIZE);assert.deepStrictEqual(Array.from(buf.slice(0,4)),[1,0,0,Math.fround(.6)]);assertClose(buf[4],.9);assertClose(buf[5],.8);assertClose(buf[6],.7);assertClose(buf[7],.3);assertClose(buf[8],.1);assertClose(buf[9],.2);assertClose(buf[10],.3);assertClose(buf[11],1);assertClose(buf[12],.4);assertClose(buf[13],.5);assertClose(buf[14],.6);assertClose(buf[15],.11);assertClose(buf[16],.12);assertClose(buf[17],.42)});it(\"reuses the caller-provided output buffer\",()=>{const out=new Float32Array(ENVIRONMENT_UNIFORM_SIZE/4);const env=resolveEnvironment();assert.strictEqual(packEnvironmentUniforms(env,out),out)})});describe(\"sunSoftness (terminator wrap)\",()=>{it(\"defaults to the historic hardcoded wrap of 0.3 and lands in float 17\",()=>{const buf=packEnvironmentUniforms(resolveEnvironment());assertClose(buf[17],.3)});it(\"clamps to [0, 1]\",()=>{assert.strictEqual(resolveEnvironment({sunSoftness:-.5}).sunSoftness,0);assert.strictEqual(resolveEnvironment({sunSoftness:2.5}).sunSoftness,1);assert.strictEqual(resolveEnvironment({sunSoftness:.6}).sunSoftness,.6)});it(\"maps a non-finite softness to 0 (crisp terminator), never NaN in the uniform\",()=>{assert.strictEqual(resolveEnvironment({sunSoftness:NaN}).sunSoftness,0);assert.strictEqual(resolveEnvironment({sunSoftness:Infinity}).sunSoftness,0);const buf=packEnvironmentUniforms(resolveEnvironment({sunSoftness:Infinity}));assert.strictEqual(buf[17],0)})});describe(\"deriveSkyGradient\",()=>{it(\"is dark at night and bright at midday\",()=>{const night=deriveSkyGradient(-.5);const day=deriveSkyGradient(.8);assert.ok(night.zenith[2]<.1);assert.ok(day.zenith[2]>.5)});it(\"warms the horizon at golden hour\",()=>{const golden=deriveSkyGradient(.08);assert.ok(golden.horizon[0]>golden.horizon[2]);const day=deriveSkyGradient(.8);assert.ok(day.horizon[2]>=day.horizon[0])});it(\"blends continuously across the twilight boundary\",()=>{const a=deriveSkyGradient(-.021);const b=deriveSkyGradient(-.019);for(let i=0;i<3;i++){assert.ok(Math.abs(a.zenith[i]-b.zenith[i])<.02)}});it(\"lifts the day/golden ground tone without warming it toward the horizon hue (#5583)\",()=>{const day=deriveSkyGradient(.35);const golden=deriveSkyGradient(.17);assert.ok(day.ground[0]>.2,`day ground should be lifted, got ${day.ground.join(\",\")}`);assert.ok(golden.ground[0]>.15,`golden ground should be lifted, got ${golden.ground.join(\",\")}`);for(const ground of[day.ground,golden.ground]){const mean=(ground[0]+ground[1]+ground[2])/3;for(const c of ground){assert.ok(Math.abs(c-mean)/mean<.12,`ground channel ${c} strays too far from neutral mean ${mean}`)}}})});\n","warnings":[],"map":{"version":3,"mappings":"kHAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cACnB,OACE,mBACA,wBACA,kBACA,6BACK,mBAEP,SAAS,YAAY,OAAgB,SAAkB,IAAM,KAAM,IAAc,CAC/E,OAAO,GAAG,KAAK,IAAI,OAAS,QAAQ,EAAI,IAAK,KAAO,GAAG,MAAM,YAAO,QAAQ,EAAE,CAChF,CAFS,kCAIT,SAAS,qBAAsB,IAAM,CACnC,GAAG,yCAA0C,IAAM,CACjD,MAAM,IAAM,mBAAmB,EAE/B,MAAM,IAAM,KAAK,MAAM,KAAO,EAAK,EAAG,EACtC,YAAY,IAAI,aAAa,CAAC,EAAG,KAAQ,GAAG,EAC5C,YAAY,IAAI,aAAa,CAAC,EAAG,EAAM,GAAG,EAC1C,YAAY,IAAI,aAAa,CAAC,EAAG,GAAM,GAAG,EAC1C,OAAO,YAAY,IAAI,aAAc,EAAG,EACxC,OAAO,gBAAgB,IAAI,SAAU,CAAC,EAAG,EAAG,CAAC,CAAC,EAC9C,OAAO,gBAAgB,IAAI,SAAU,CAAC,IAAM,IAAM,GAAI,CAAC,EACvD,OAAO,gBAAgB,IAAI,YAAa,CAAC,IAAM,GAAK,GAAI,CAAC,EACzD,OAAO,YAAY,IAAI,iBAAkB,IAAK,EAC9C,OAAO,YAAY,IAAI,cAAe,EAAG,EACzC,OAAO,YAAY,IAAI,aAAc,GAAI,EACzC,OAAO,YAAY,IAAI,YAAa,EAAG,EACvC,OAAO,YAAY,IAAI,SAAU,GAAI,EACrC,OAAO,YAAY,IAAI,WAAY,KAAK,CAC1C,CAAC,EAED,GAAG,sCAAuC,IAAM,CAC9C,MAAM,IAAM,mBAAmB,CAAE,aAAc,CAAC,EAAG,EAAG,CAAC,CAAE,CAAC,EAC1D,OAAO,gBAAgB,IAAI,aAAc,CAAC,EAAG,EAAG,CAAC,CAAC,CACpD,CAAC,EAED,GAAG,2DAA4D,IAAM,CACnE,MAAM,IAAM,mBAAmB,CAAE,aAAc,CAAC,EAAG,EAAG,CAAC,CAAE,CAAC,EAC1D,OAAO,GAAG,IAAI,aAAa,CAAC,EAAI,EAAG,EACnC,YAAY,KAAK,MAAM,GAAG,IAAI,YAAY,EAAG,CAAC,CAChD,CAAC,EAED,GAAG,sDAAuD,IAAM,CAC9D,MAAM,IAAM,mBAAmB,CAC7B,aAAc,CAAC,EAAG,EAAG,CAAC,EACtB,IAAK,CAAE,OAAQ,CAAC,EAAG,EAAG,CAAC,CAAE,CAC3B,CAAC,EACD,OAAO,gBAAgB,IAAI,IAAI,OAAQ,CAAC,EAAG,EAAG,CAAC,CAAC,EAEhD,OAAO,GAAG,IAAI,IAAI,QAAQ,CAAC,EAAI,EAAG,CACpC,CAAC,CACH,CAAC,EAYD,SAAS,wEAAyE,IAAM,CACtF,MAAM,QAAU,mBAAmB,EAAE,aAErC,GAAG,uCAAwC,IAAM,CAC/C,MAAM,IAAM,mBAAmB,CAAE,aAAc,CAAC,SAAU,EAAG,EAAG,CAAE,CAAC,EACnE,OAAO,gBAAgB,IAAI,aAAc,OAAO,CAClD,CAAC,EAED,GAAG,uCAAwC,IAAM,CAC/C,MAAM,IAAM,mBAAmB,CAAE,aAAc,CAAC,GAAK,UAAW,EAAG,CAAE,CAAC,EACtE,OAAO,gBAAgB,IA