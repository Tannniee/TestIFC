{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert/strict\";import{VisualEnhancementResolver}from\"./visual-enhancement.js\";describe(\"VisualEnhancementResolver ranges (#5384)\",()=>{it(\"keeps an AO radius in world units, clamped to 0.05-10\",()=>{const r=new VisualEnhancementResolver;assert.equal(r.resolve({contactShading:{radius:1.5}}).contactShading.radius,1.5);assert.equal(r.resolve({contactShading:{radius:4}}).contactShading.radius,4);assert.equal(r.resolve({contactShading:{radius:25}}).contactShading.radius,10);assert.equal(r.resolve({contactShading:{radius:.001}}).contactShading.radius,.05)});it(\"clamps both intensities to 0-1\",()=>{const r=new VisualEnhancementResolver;const high=r.resolve({contactShading:{intensity:3},separationLines:{intensity:2}});assert.equal(high.contactShading.intensity,1);assert.equal(high.separationLines.intensity,1);const low=r.resolve({contactShading:{intensity:-1},separationLines:{intensity:-.5}});assert.equal(low.contactShading.intensity,0);assert.equal(low.separationLines.intensity,0);assert.equal(r.resolve({contactShading:{intensity:.4}}).contactShading.intensity,.4)});it(\"keeps the edge-pass tap radius in pixels, clamped to 1-3 (#5385: widened from 1-2 for the diagonal taps at high quality)\",()=>{const r=new VisualEnhancementResolver;assert.equal(r.resolve({separationLines:{radius:5}}).separationLines.radius,3);assert.equal(r.resolve({separationLines:{radius:0}}).separationLines.radius,1);assert.equal(r.resolve({separationLines:{radius:1.5}}).separationLines.radius,1.5)});it(\"keeps the previous value when a frame passes a non-finite one\",()=>{const r=new VisualEnhancementResolver;r.resolve({contactShading:{radius:2,intensity:.7}});const next=r.resolve({contactShading:{radius:Number.NaN,intensity:Number.POSITIVE_INFINITY}});assert.equal(next.contactShading.radius,2);assert.equal(next.contactShading.intensity,.7)});it(\"still carries omitted options over from the previous frame\",()=>{const r=n