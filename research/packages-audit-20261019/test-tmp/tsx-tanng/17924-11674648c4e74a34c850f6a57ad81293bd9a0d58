{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert\";import{VisibilityEpochTracker}from\"./visibility-epoch.js\";describe(\"VisibilityEpochTracker\",()=>{it(\"starts at version 0 and stays there while no filtering is passed\",()=>{const t=new VisibilityEpochTracker;assert.strictEqual(t.update(void 0,void 0),0);assert.strictEqual(t.update(void 0,null),0);assert.strictEqual(t.update(new Set,void 0),0,\"empty hidden set == no hidden filter\")});it(\"bumps when a hidden filter appears and when it disappears\",()=>{const t=new VisibilityEpochTracker;assert.strictEqual(t.update(new Set([1,2]),void 0),1);assert.strictEqual(t.update(void 0,void 0),2)});it(\"detects IN-PLACE mutation of the same hidden Set reference\",()=>{const t=new VisibilityEpochTracker;const hidden=new Set([1,2]);const v1=t.update(hidden,void 0);assert.strictEqual(t.update(hidden,void 0),v1,\"unchanged content, same ref: stable\");hidden.add(3);const v2=t.update(hidden,void 0);assert.ok(v2>v1,\"in-place add must bump the version\");hidden.delete(3);assert.ok(t.update(hidden,void 0)>v2,\"in-place delete must bump the version\")});it(\"detects an equal-size in-place swap (delete one id, add another)\",()=>{const t=new VisibilityEpochTracker;const hidden=new Set([5,6]);const v1=t.update(hidden,void 0);hidden.delete(5);hidden.add(7);assert.ok(t.update(hidden,void 0)>v1)});it(\"does NOT bump for a fresh Set with identical content\",()=>{const t=new VisibilityEpochTracker;const v1=t.update(new Set([1,2,3]),new Set([9]));assert.strictEqual(t.update(new Set([3,2,1]),new Set([9])),v1)});it(\"detects in-place mutation of the isolated Set\",()=>{const t=new VisibilityEpochTracker;const isolated=new Set([10,11]);const v1=t.update(void 0,isolated);isolated.delete(11);assert.ok(t.update(void 0,isolated)>v1)});it(\"treats an EMPTY isolated set as different from null (isolate-nothing hides everything)\",()=>{const t=new VisibilityEpochTracker;const v1=t.update(void 0,new Set);assert.ok(v1>0,\"empty isolation is a real filter\");assert.strictEqual(t.update(void 0,new Set),v1,\"stays stable while empty isolation holds\");assert.ok(t.update(void 0,null)>v1,\"dropping isolation is a change\")});it(\"snapshots content: later mutation of a set passed earlier cannot corrupt history\",()=>{const t=new VisibilityEpochTracker;const hidden=new Set([1]);const v1=t.update(hidden,void 0);hidden.add(2);const v2=t.update(hidden,void 0);assert.ok(v2>v1);assert.strictEqual(t.update(new Set([1,2]),void 0),v2)});it(\"hide -> show-all -> hide same set -> different set bumps each transition\",()=>{const t=new VisibilityEpochTracker;const a=new Set([1,2]);const v1=t.update(a,void 0);const v2=t.update(void 0,void 0);const v3=t.update(new Set([1,2]),void 0);const v4=t.update(new Set([3]),void 0);assert.ok(v1<v2&&v2<v3&&v3<v4)})});\n","warnings":[],"map":{"version":3,"mappings":"AAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cACnB,OAAS,2BAA8B,wBAEvC,SAAS,yBAA0B,IAAM,CACvC,GAAG,mEAAoE,IAAM,CAC3E,MAAM,EAAI,IAAI,uBACd,OAAO,YAAY,EAAE,OAAO,OAAW,MAAS,EAAG,CAAC,EACpD,OAAO,YAAY,EAAE,OAAO,OAAW,IAAI,EAAG,CAAC,EAC/C,OAAO,YAAY,EAAE,OAAO,IAAI,IAAO,MAAS,EAAG,EAAG,sCAAsC,CAC9F,CAAC,EAED,GAAG,4DAA6D,IAAM,CACpE,MAAM,EAAI,IAAI,uBACd,OAAO,YAAY,EAAE,OAAO,IAAI,IAAI,CAAC,EAAG,CAAC,CAAC,EAAG,MAAS,EAAG,CAAC,EAC1D,OAAO,YAAY,EAAE,OAAO,OAAW,MAAS,EAAG,CAAC,CACtD,CAAC,EAED,GAAG,6DAA8D,IAAM,CACrE,MAAM,EAAI,IAAI,uBACd,MAAM,OAAS,IAAI,IAAI,CAAC,EAAG,CAAC,CAAC,EAC7B,MAAM,GAAK,EAAE,OAAO,OAAQ,MAAS,EACrC,OAAO,YAAY,EAAE,OAAO,OAAQ,MAAS,EAAG,GAAI,qCAAqC,EACzF,OAAO,IAAI,CAAC,EACZ,MAAM,GAAK,EAAE,OAAO,OAAQ,MAAS,EACrC,OAAO,GAAG,GAAK,GAAI,oCAAoC,EACvD,OAAO,OAAO,CAAC,EACf,OAAO,GAAG,EAAE,OAAO,OAAQ,MAAS,EAAI,GAAI,uCAAuC,CACrF,CAAC,EAED,GAAG,mEAAoE,IAAM,CAC3E,MAAM,EAAI,IAAI,uBACd,MAAM,OAAS,IAAI,IAAI,CAAC,EAAG,CAAC,CAAC,EAC7B,MAAM,GAAK,EAAE,OAAO,OAAQ,MAAS,EACrC,OAAO,OAAO,CAAC,EACf,OAAO,IAAI,CAAC,EACZ,OAAO,GAAG,EAAE,OAAO,OAAQ,MAAS,EAAI,EAAE,CAC5C,CAAC,EAED,GAAG,uDAAwD,IAAM,CAC/D,MAAM,EAAI,IAAI,uBACd,MAAM,GAAK,EAAE,OAAO,IAAI,IAAI,CAAC,EAAG,