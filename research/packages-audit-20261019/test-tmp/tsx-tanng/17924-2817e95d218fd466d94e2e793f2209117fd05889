{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert\";import{packClipBox,CLIPBOX_ENABLED_BIT}from\"./clip-box.js\";describe(\"packClipBox\",()=>{const box={min:[-1,-2,-3],max:[4,5,6],enabled:true};it(\"writes min.xyz / max.xyz at the offset and returns the enabled bit\",()=>{const out=new Float32Array(56);const bit=packClipBox(box,out,48);assert.strictEqual(bit,CLIPBOX_ENABLED_BIT);assert.deepStrictEqual([...out.slice(48,51)],[-1,-2,-3]);assert.deepStrictEqual([...out.slice(52,55)],[4,5,6])});it(\"zeroes the w padding lanes (51 and 55)\",()=>{const out=new Float32Array(56).fill(9);packClipBox(box,out,48);assert.strictEqual(out[51],0);assert.strictEqual(out[55],0)});it(\"returns 0 and zeroes the region when disabled\",()=>{const out=new Float32Array(56).fill(7);const bit=packClipBox({...box,enabled:false},out,48);assert.strictEqual(bit,0);for(let i=48;i<56;i++)assert.strictEqual(out[i],0,`lane ${i}`)});it(\"returns 0 and zeroes the region when null/undefined\",()=>{const out=new Float32Array(56).fill(7);assert.strictEqual(packClipBox(null,out,48),0);assert.strictEqual(packClipBox(void 0,out,48),0);for(let i=48;i<56;i++)assert.strictEqual(out[i],0,`lane ${i}`)});it(\"honours an arbitrary float offset\",()=>{const out=new Float32Array(16);packClipBox(box,out,4);assert.deepStrictEqual([...out.slice(4,7)],[-1,-2,-3]);assert.deepStrictEqual([...out.slice(8,11)],[4,5,6]);assert.deepStrictEqual([...out.slice(0,4)],[0,0,0,0])})});\n","warnings":[],"map":{"version":3,"mappings":"AAWA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,cAEnB,OAAS,YAAa,wBAA2B,gBAGjD,SAAS,cAAe,IAAM,CAC5B,MAAM,IAAe,CAAE,IAAK,CAAC,GAAI,GAAI,EAAE,EAAG,IAAK,CAAC,EAAG,EAAG,CAAC,EAAG,QAAS,IAAK,EAExE,GAAG,qEAAsE,IAAM,CAC7E,MAAM,IAAM,IAAI,aAAa,EAAE,EAC/B,MAAM,IAAM,YAAY,IAAK,IAAK,EAAE,EACpC,OAAO,YAAY,IAAK,mBAAmB,EAC3C,OAAO,gBAAgB,CAAC,GAAG,IAAI,MAAM,GAAI,EAAE,CAAC,EAAG,CAAC,GAAI,GAAI,EAAE,CAAC,EAC3D,OAAO,gBAAgB,CAAC,GAAG,IAAI,MAAM,GAAI,EAAE,CAAC,EAAG,CAAC,EAAG,EAAG,CAAC,CAAC,CAC1D,CAAC,EAED,GAAG,yCA