{"code":"import{describe,it}from\"node:test\";import assert from\"node:assert/strict\";import{skyShaderSource}from\"./shaders/sky.wgsl.js\";describe(\"sky shader smoothstep edges (WGSL low < high)\",()=>{it(\"has no numeric-literal smoothstep with low >= high\",()=>{const re=/smoothstep\\s*\\(\\s*(-?\\d+(?:\\.\\d+)?)\\s*,\\s*(-?\\d+(?:\\.\\d+)?)\\s*,/g;const seen=[];for(const m of skyShaderSource.matchAll(re)){const low=Number(m[1]);const high=Number(m[2]);seen.push({low,high});assert.ok(low<high,`smoothstep(${m[1]}, ${m[2]}, \\u2026) has low >= high \\u2014 WGSL rejects this`)}assert.ok(seen.length>=2,\"expected the sky shader to keep its literal-edge smoothstep calls\")})});describe(\"sky shader ground falloff (#5583)\",()=>{it(\"spans a wide elevation range, not the old near-instant -0.1\",()=>{const m=skyShaderSource.match(/let groundMix = 1\\.0 - smoothstep\\((-?\\d+(?:\\.\\d+)?), (-?\\d+(?:\\.\\d+)?), elevation\\);/);assert.ok(m,\"expected a literal-edge groundMix smoothstep to match against\");const low=Number(m[1]);const high=Number(m[2]);assert.equal(high,0,\"the transition should still end exactly at the horizon\");assert.ok(low<=-.4,`expected a gradual falloff (low <= -0.4), got low=${low} (the old, flatter value was -0.1)`)});it(\"does not regress to the old -0.1 cutoff\",()=>{assert.ok(!skyShaderSource.includes(\"smoothstep(-0.1, 0.0, elevation)\"),\"the ground falloff should no longer use the narrow -0.1..0.0 range\")})});\n","warnings":[],"map":{"version":3,"mappings":"AAIA,OAAS,SAAU,OAAU,YAC7B,OAAO,WAAY,qBACnB,OAAS,oBAAuB,wBAehC,SAAS,gDAAiD,IAAM,CAC9D,GAAG,qDAAsD,IAAM,CAI7D,MAAM,GAAK,mEACX,MAAM,KAA6C,CAAC,EACpD,UAAW,KAAK,gBAAgB,SAAS,EAAE,EAAG,CAC5C,MAAM,IAAM,OAAO,EAAE,CAAC,CAAC,EACvB,MAAM,KAAO,OAAO,EAAE,CAAC,CAAC,EACxB,KAAK,KAAK,CAAE,IAAK,IAAK,CAAC,EACvB,OAAO,GACL,IAAM,KACN,cAAc,EAAE,CAAC,CAAC,KAAK,EAAE,CAAC,CAAC,oDAC7B,CACF,CAGA,OAAO,GAAG,KAAK,QAAU,EAAG,mEAAmE,CACjG,CAAC,CACH,CAAC,EAUD,SAAS,oCAAqC,IAAM,CAClD,GAAG,8DAA+D,IAAM,CACtE,MAAM,EAAI,gBAAgB,M