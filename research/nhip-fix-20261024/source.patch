+/// Finished union difference retaining EVERY material component. Unlike the
+/// single-profile API this is suitable for a through-slot splitting a plate.
+/// Empty/degenerate output refuses the analytic route rather than losing a part.
+pub(crate) fn subtract_multiple_2d_all(
+    profile: &Profile2D,
+    void_contours: &[Vec<Point2<f64>>],
+) -> Result<Vec<Profile2D>> {
+    let subject = profile_to_paths(profile);
+    let clip = ccw_paths(void_contours.iter().map(Vec::as_slice));
+    let shapes = subject.overlay(&clip, OverlayRule::Difference, FillRule::NonZero);
+    if shapes.is_empty() {
+        return Err(Error::InvalidProfile("Boolean difference consumed the host".into()));
+    }
+    shapes.iter().map(|shape| {
+        if shape.is_empty() || shape.iter().any(|contour| {
+            let points = contour.iter().map(|p| Point2::new(p[0], p[1])).collect::<Vec<_>>();
+            !points.iter().all(|p| p.x.is_finite() && p.y.is_finite()) || !is_valid_contour(&points)
+        }) {
+            return Err(Error::InvalidProfile("Boolean difference has a degenerate contour".into()));
+        }
+        shapes_to_profile(std::slice::from_ref(shape))
+    }).collect()
+}
